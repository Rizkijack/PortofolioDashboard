# === Wallet ===
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Isi dari cloud.reown.com (32 hex). Tanpa ini, connect fallback ke injected wallet.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: jika pakai Privy, isi App ID dari dashboard.privy.io

# === RPC (semua sudah diverifikasi hidup — lihat lib/chains.ts RPC_FAILOVER) ===
# Kosongkan untuk pakai default public RPC + failover otomatis via withFailover().
NEXT_PUBLIC_RPC_ROBINHOOD=https://robinhood-rpc.publicnode.com
NEXT_PUBLIC_RPC_BASE=https://mainnet.base.org
NEXT_PUBLIC_RPC_BSC=https://bsc-dataseed.binance.org
NEXT_PUBLIC_RPC_HYPEREVM=https://rpc.hyperliquid.xyz/evm
NEXT_PUBLIC_RPC_INK=https://rpc-gel.inkonchain.com

# === Oracle (TIDAK butuh API key — semua keyless) ===
# Tier 1: Chainlink on-chain (multicall latestRoundData) + RedStone push (Ink)
# Tier 2: Binance WS stream (sub-detik, aset mayor) + RedStone API (median multi-exchange)
# Tier 3: DexScreener (long-tail) + Blockscout exchange_rate (token Robinhood)

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
